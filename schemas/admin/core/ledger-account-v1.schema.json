{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kerosene.invalid/admin/core/ledger-account-v1.schema.json",
  "title": "LedgerAccountV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "account_id",
    "account_type",
    "available_sats",
    "reserved_sats",
    "pending_incoming_sats",
    "pending_outgoing_sats",
    "confirmed_onchain_sats",
    "unconfirmed_onchain_sats",
    "spendable_by_kerosene_sats",
    "state_version",
    "state_root",
    "tags",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "contract_version": {"const": "0.1.0"},
    "account_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "account_type": {"type": "string", "minLength": 1, "maxLength": 64},
    "available_sats": {"type": "integer", "minimum": 0},
    "reserved_sats": {"type": "integer", "minimum": 0},
    "pending_incoming_sats": {"type": "integer", "minimum": 0},
    "pending_outgoing_sats": {"type": "integer", "minimum": 0},
    "confirmed_onchain_sats": {"type": "integer", "minimum": 0},
    "unconfirmed_onchain_sats": {"type": "integer", "minimum": 0},
    "spendable_by_kerosene_sats": {"type": "integer", "minimum": 0},
    "state_version": {"type": "integer", "minimum": 0},
    "state_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 64}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
