{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kerosene.invalid/discovery/state-snapshot-attestation-v1.schema.json",
  "title": "StateSnapshotAttestationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "network_id",
    "plane",
    "membership_manifest_hash",
    "snapshot_epoch",
    "state_root",
    "created_at_epoch_ms",
    "signatures"
  ],
  "properties": {
    "contract_version": { "const": "0.2.0" },
    "network_id": { "type": "string", "minLength": 1 },
    "plane": { "enum": ["bank", "vault"] },
    "membership_manifest_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "snapshot_epoch": { "type": "integer", "minimum": 1 },
    "state_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "created_at_epoch_ms": { "type": "integer", "minimum": 1 },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signer_id", "signature"],
        "properties": {
          "signer_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
        }
      }
    }
  }
}
