{
  "$id": "urn:kerosene:cell-admission-envelope-v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "CellAdmissionSignatureV1": {
      "additionalProperties": false,
      "properties": {
        "memberId": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$",
          "type": "string"
        },
        "signatureBase64": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$",
          "type": "string"
        }
      },
      "required": [
        "memberId",
        "signatureBase64"
      ],
      "type": "object"
    },
    "CellAdmissionV1": {
      "additionalProperties": false,
      "properties": {
        "cellId": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$",
          "type": "string"
        },
        "changeId": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$",
          "type": "string"
        },
        "clusterUid": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "epoch": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "expiresAtUnixSeconds": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "issuedAtUnixSeconds": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "networkId": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$",
          "type": "string"
        },
        "nonce": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "operatorId": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$",
          "type": "string"
        },
        "releaseApprovalDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "schema": {
          "const": "kerosene.cell-admission/v1",
          "type": "string"
        }
      },
      "required": [
        "cellId",
        "changeId",
        "clusterUid",
        "epoch",
        "expiresAtUnixSeconds",
        "issuedAtUnixSeconds",
        "networkId",
        "nonce",
        "operatorId",
        "releaseApprovalDigest",
        "schema"
      ],
      "type": "object"
    }
  },
  "properties": {
    "admission": {
      "$ref": "#/definitions/CellAdmissionV1"
    },
    "signatures": {
      "items": {
        "$ref": "#/definitions/CellAdmissionSignatureV1"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "admission",
    "signatures"
  ],
  "title": "CellAdmissionEnvelopeV1",
  "type": "object"
}
